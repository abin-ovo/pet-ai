{
  "name": "xiaotuan-desktop-pet",
  "version": "0.1.3",
  "private": true,
  "description": "小团 · 你的桌面小伙伴",
  "main": "out/main/index.js",
  "author": "Xiaotuan",
  "scripts": {
    "icons": "node scripts/build-icons.cjs",
    "setup:electron": "node scripts/install-electron.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:mac": "npm run build && electron-builder --mac --dir --config.electronDist=node_modules/electron/dist",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:win:zip": "npm run build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  }
}
